# Vercel AI Gateway (preferred) — local / CI / non-OIDC.
# On Vercel deployments, OIDC (VERCEL_OIDC_TOKEN) can authenticate without this key
# when AI Gateway is enabled for the team.
AI_GATEWAY_API_KEY=

# Optional direct xAI fallback when Gateway credentials are absent.
# Also usable as BYOK for xAI models on the Gateway team.
# Never expose to the client; route handlers read server-side only.
XAI_API_KEY=

# Optional usage caps (sensible low defaults shown)
XAI_RATE_LIMIT_PER_IP_PER_MINUTE=5
XAI_RATE_LIMIT_PER_IP_PER_DAY=30
XAI_RATE_LIMIT_GLOBAL_PER_DAY=200
XAI_MAX_PROMPT_LENGTH=500
XAI_VISION_MAX_EDGE=768
XAI_VISION_MAX_BASE64_CHARS=900000

# ---------------------------------------------------------------------------
# Monetization (all optional — build and tests pass with none of these set;
# each feature shows a "not configured" state instead).
# ---------------------------------------------------------------------------

# Canonical origin for metadata, sitemap, robots (falls back to Vercel URL env).
NEXT_PUBLIC_APP_URL=
# Optional support address shown on /support.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Neon Postgres. Pooled URL for runtime; direct (unpooled) URL for migrations.
# Use a Neon PREVIEW branch for previews — never production data.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Managed Auth (Better Auth). Cookie secret must be 32+ chars:
#   openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Show "Continue with Apple" (requires Apple configured in Neon Console).
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false

# Stripe — TEST MODE ONLY (sk_test_…). Live keys are refused unless
# ALLOW_LIVE_STRIPE=true AND NODE_ENV=production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_TAX_ENABLED=false
STRIPE_PORTAL_CONFIGURATION_ID=
# David flips this only after approval. Leave false.
ALLOW_LIVE_STRIPE=false
# Sell the $5 / 50-action AI pack (asc_ai_pack_50).
AI_PACKS_ENABLED=false

# Private storage for paid downloads (Vercel Blob, private access).
BLOB_READ_WRITE_TOKEN=

# Comma-separated admin emails (reserved for admin tooling).
ADMIN_EMAILS=

# Quota overrides (defaults shown).
QUOTA_FREE_AI_PER_DAY=3
QUOTA_PRO_AI_PER_MONTH=150
QUOTA_LIFETIME_AI_PER_MONTH=50

# Export badge text for free plans.
NEXT_PUBLIC_WATERMARK_TEXT=
