# xAI Grok — required for AI background generation + screenshot analysis.
# Never expose this key to the client; route handlers read it server-side only.
XAI_API_KEY=

# Optional usage caps (sensible low defaults shown)
XAI_RATE_LIMIT_PER_IP_PER_MINUTE=5
XAI_RATE_LIMIT_PER_IP_PER_DAY=30
XAI_RATE_LIMIT_GLOBAL_PER_DAY=200
XAI_MAX_PROMPT_LENGTH=500
XAI_VISION_MAX_EDGE=768
XAI_VISION_MAX_BASE64_CHARS=900000
