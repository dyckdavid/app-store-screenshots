# Vercel AI Gateway (preferred) — local / CI / non-OIDC.
# On Vercel deployments, OIDC (VERCEL_OIDC_TOKEN) can authenticate without this key
# when AI Gateway is enabled for the team.
AI_GATEWAY_API_KEY=

# Optional direct xAI fallback when Gateway credentials are absent.
# Also usable as BYOK for xAI models on the Gateway team.
# Never expose to the client; route handlers read server-side only.
XAI_API_KEY=

# Optional usage caps (sensible low defaults shown)
XAI_RATE_LIMIT_PER_IP_PER_MINUTE=5
XAI_RATE_LIMIT_PER_IP_PER_DAY=30
XAI_RATE_LIMIT_GLOBAL_PER_DAY=200
XAI_MAX_PROMPT_LENGTH=500
XAI_VISION_MAX_EDGE=768
XAI_VISION_MAX_BASE64_CHARS=900000
